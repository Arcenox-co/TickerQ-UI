# Supabase project API settings. Keep the service-role key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-local-env-only

# Random 32+ byte secret used to HMAC rate-limit identifiers.
SURVEY_RATE_LIMIT_SECRET=replace-with-a-random-secret

# Header overwritten by your trusted reverse proxy. The origin must not be public.
# Supported: x-real-ip, cf-connecting-ip, fly-client-ip, true-client-ip.
SURVEY_CLIENT_IP_HEADER=x-real-ip

# Optional email notification through Resend. Leave all three empty to disable.
RESEND_API_KEY=
SURVEY_NOTIFICATION_EMAIL=
SURVEY_FROM_EMAIL=TickerQ Survey <survey@your-verified-domain.example>
